<Project Sdk="WixToolset.Sdk/7.0.0">
    <PropertyGroup>
        <AutoVersion Condition="'$(AutoVersion)' == ''">0.0.1</AutoVersion>
        <OutputType>Package</OutputType>
        <OutputName>Auto-$(AutoVersion)-x64</OutputName>
        <InstallerPlatform>x64</InstallerPlatform>
        <DefineConstants>AutoVersion=$(AutoVersion)</DefineConstants>
        <AcceptEula>wix7</AcceptEula>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="WixToolset.NetFx.wixext" Version="7.0.0" />
        <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
        <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Auto\Auto.csproj">
            <Publish>true</Publish>
            <Configuration>Release</Configuration>
            <Platform>x64</Platform>
            <Properties>RuntimeIdentifier=win-x64</Properties>
        </ProjectReference>
    </ItemGroup>
</Project>
